<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="wheels.xacro" />

    <xacro:macro name="body_section" params="x length width height">
        <visual>
            <origin xyz="${x} 0 0"/>
            <geometry><box size="${length} ${width} ${height}"/></geometry>
            <material name="body_material"/>
        </visual>
        <collision>
            <origin xyz="${x} 0 0"/>
            <geometry><box size="${length} ${width} ${height}"/></geometry>
        </collision>
    </xacro:macro>

    <xacro:macro name="core" params="vehicle_length vehicle_width wheelbase front_track rear_track wheel_radius wheel_width wheel_outer_overhang steering_axis_offset front_body_width middle_body_width rear_body_width front_body_length middle_body_length rear_body_length chamfer_length body_height lidar_x_rear_axle">

        <link name="base_footprint"/>
        <joint name="base_footprint_to_imu_joint" type="fixed">
            <!-- Temporary center-of-chassis placement; adjust after measuring the installed IMU. -->
            <origin xyz="${wheelbase / 2.0} 0.0 ${wheel_radius}" rpy="0.0 0.0 0.0"/>
            <parent link="base_footprint"/>
            <child link="imu_link"/>
        </joint>
        <link name="imu_link"/>

        <joint name="base_footprint_to_base_link_joint" type="fixed">
            <origin xyz="${wheelbase / 2.0} 0 ${wheel_radius}" rpy="0.0 0.0 0.0"/>
            <parent link="base_footprint"/>
            <child link="base_link"/>
        </joint>
        <link name="base_link"/>

        <joint name="base_link_to_rear_axle_joint" type="fixed">
            <origin xyz="${-wheelbase / 2.0} 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <parent link="base_link"/>
            <child link="rear_axle"/>
        </joint>
        <link name="rear_axle" />

        <joint name="chassis_joint" type="fixed">
            <parent link="base_link"/>
            <child link="chassis"/>
            <origin xyz="0.0 0.0 0.0"/>
        </joint>
        <link name="chassis">
            <xacro:body_section x="${-vehicle_length / 2.0 + rear_body_length / 2.0}" length="${rear_body_length}" width="${rear_body_width}" height="${body_height}"/>
            <xacro:body_section x="${-vehicle_length / 2.0 + rear_body_length + chamfer_length / 6.0}" length="${chamfer_length / 3.0}" width="${(rear_body_width * 2.0 + middle_body_width) / 3.0}" height="${body_height}"/>
            <xacro:body_section x="${-vehicle_length / 2.0 + rear_body_length + chamfer_length / 2.0}" length="${chamfer_length / 3.0}" width="${(rear_body_width + middle_body_width) / 2.0}" height="${body_height}"/>
            <xacro:body_section x="${-vehicle_length / 2.0 + rear_body_length + 5.0 * chamfer_length / 6.0}" length="${chamfer_length / 3.0}" width="${(rear_body_width + middle_body_width * 2.0) / 3.0}" height="${body_height}"/>
            <xacro:body_section x="${-vehicle_length / 2.0 + rear_body_length + chamfer_length + middle_body_length / 2.0}" length="${middle_body_length}" width="${middle_body_width}" height="${body_height}"/>
            <xacro:body_section x="${vehicle_length / 2.0 - front_body_length - 5.0 * chamfer_length / 6.0}" length="${chamfer_length / 3.0}" width="${(front_body_width + middle_body_width * 2.0) / 3.0}" height="${body_height}"/>
            <xacro:body_section x="${vehicle_length / 2.0 - front_body_length - chamfer_length / 2.0}" length="${chamfer_length / 3.0}" width="${(front_body_width + middle_body_width) / 2.0}" height="${body_height}"/>
            <xacro:body_section x="${vehicle_length / 2.0 - front_body_length - chamfer_length / 6.0}" length="${chamfer_length / 3.0}" width="${(front_body_width * 2.0 + middle_body_width) / 3.0}" height="${body_height}"/>
            <xacro:body_section x="${vehicle_length / 2.0 - front_body_length / 2.0}" length="${front_body_length}" width="${front_body_width}" height="${body_height}"/>
        </link>
        <xacro:wheel_unit prefix="front_left"  parent="base_link" x_pos="${wheelbase / 2.0}" y_pos="${front_track / 2.0}" z_pos="0.0" side_reflect="1" is_steer="true" wheel_radius="${wheel_radius}" wheel_width="${wheel_width}" wheel_outer_overhang="${wheel_outer_overhang}" steering_axis_offset="${steering_axis_offset}" />
        <xacro:wheel_unit prefix="front_right" parent="base_link" x_pos="${wheelbase / 2.0}" y_pos="${-front_track / 2.0}" z_pos="0.0" side_reflect="-1" is_steer="true" wheel_radius="${wheel_radius}" wheel_width="${wheel_width}" wheel_outer_overhang="${wheel_outer_overhang}" steering_axis_offset="${steering_axis_offset}" />

        <xacro:wheel_unit prefix="rear_left"   parent="rear_axle" x_pos="0.0" y_pos="${rear_track / 2.0}" z_pos="0.0" side_reflect="1" is_steer="false" wheel_radius="${wheel_radius}" wheel_width="${wheel_width}" wheel_outer_overhang="${wheel_outer_overhang}" steering_axis_offset="${steering_axis_offset}" />
        <xacro:wheel_unit prefix="rear_right"  parent="rear_axle" x_pos="0.0" y_pos="${-rear_track / 2.0}" z_pos="0.0" side_reflect="-1" is_steer="false" wheel_radius="${wheel_radius}" wheel_width="${wheel_width}" wheel_outer_overhang="${wheel_outer_overhang}" steering_axis_offset="${steering_axis_offset}" />

        <joint name="base_laser_joint" type="fixed">
            <origin xyz="${lidar_x_rear_axle - wheelbase / 2.0} 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <parent link="chassis"/>
            <child link="base_laser"/>
        </joint>
        <link name="base_laser">
            <visual name="">
                <origin xyz="0. 0.0 0.0276"/>
                <geometry>
                    <cylinder radius="0.06" length="0.0684"/>
                </geometry>
                <material name="sensor_mount_material"/>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0276"/>
                <geometry>
                    <cylinder radius="0.06" length="0.0684"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>

</robot>
