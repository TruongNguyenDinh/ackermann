<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="wheel_unit" params="prefix parent x_pos y_pos z_pos side_reflect is_steer wheel_radius wheel_width wheel_outer_overhang steering_axis_offset">
        
        <joint name="${prefix}_steer_joint" type="${'revolute' if is_steer else 'fixed'}">
            <parent link="${parent}"/>
            <child link="${prefix}_steer_link"/>
            <origin xyz="${x_pos} ${y_pos - side_reflect * steering_axis_offset} ${z_pos}" rpy="0.0 0.0 0.0"/>
            <xacro:if value="${is_steer}">
                <axis xyz="0.0 0.0 1"/>
                <limit lower="-0.261799" upper="0.261799" effort="0.1" velocity="1.0"/>
                <dynamics damping="0.05" friction="0.02"/>
            </xacro:if>
        </joint>

        <link name="${prefix}_steer_link">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="${-side_reflect * pi/2} 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.005" length="0.0369"/>  
                </geometry>
                <material name="steering_material"/>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="${-side_reflect * pi/2} 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.005" length="0.0369"/>  
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <origin xyz="0.0 ${side_reflect * steering_axis_offset} 0.0" rpy="-${pi/2} 0.0 0.0"/>
            <parent link="${prefix}_steer_link"/>
            <child link="${prefix}_wheel"/>
            <axis xyz="0.0 0.0 1"/>
            <dynamics damping="0.01" friction="0.005"/>
        </joint>

        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="${'front_wheel_material' if prefix.startswith('front') else 'rear_wheel_material'}"/>
            </visual>
            <!-- Estimated outer bevel band: 4.7 mm per side matches the
                 measured total width while keeping the 40.8 mm tire body. -->
            <visual>
                <origin xyz="0.0 0.0 ${side_reflect * (wheel_width / 2.0 + wheel_outer_overhang / 2.0)}"/>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_outer_overhang}"/></geometry>
                <material name="${'front_wheel_material' if prefix.startswith('front') else 'rear_wheel_material'}"/>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <collision>
                <origin xyz="0.0 0.0 ${side_reflect * (wheel_width / 2.0 + wheel_outer_overhang / 2.0)}"/>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_outer_overhang}"/></geometry>
            </collision>
        </link>
    </xacro:macro>

</robot>
