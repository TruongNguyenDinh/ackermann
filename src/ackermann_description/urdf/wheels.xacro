<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="wheel_unit" params="prefix parent x_pos y_pos z_pos side_reflect is_steer wheel_radius wheel_width steering_axis_offset">
        
        <joint name="${prefix}_steer_joint" type="${'revolute' if is_steer else 'fixed'}">
            <parent link="${parent}"/>
            <child link="${prefix}_steer_link"/>
            <!-- Keep the existing kingpin-to-wheel-center offset as an
                 adjustable estimate; y_pos denotes the tire center. -->
            <origin xyz="${x_pos} ${y_pos - side_reflect * steering_axis_offset} ${z_pos}" rpy="0.0 0.0 0.0"/>
            <xacro:if value="${is_steer}">
                <axis xyz="0.0 0.0 1"/>
                <limit lower="-0.261799" upper="0.261799" effort="0.1" velocity="1.0"/>
                <dynamics damping="0.05" friction="0.02"/>
            </xacro:if>
        </joint>

        <link name="${prefix}_steer_link">
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mass value="0.05"/>
                <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
            </inertial>
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="${-side_reflect * pi/2} 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.005" length="0.0369"/>  
                </geometry>
                <material name="green_material">
                    <color rgba="0.0 1.0 0.0 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="${-side_reflect * pi/2} 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.005" length="0.0369"/>  
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <origin xyz="0.0 ${side_reflect * steering_axis_offset} 0.0" rpy="-${pi/2} 0.0 0.0"/>
            <parent link="${prefix}_steer_link"/>
            <child link="${prefix}_wheel"/>
            <axis xyz="0.0 0.0 1"/>
            <dynamics damping="0.01" friction="0.005"/>
        </joint>

        <link name="${prefix}_wheel">
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <mass value="0.05"/>  <!-- thay vì 0.01 -->
                <inertia ixx="0.0003" ixy="0.0" ixz="0.0" iyy="0.0003" iyz="0.0" izz="0.0003"/>
            </inertial>
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="red_material">
                    <color rgba="1.0 0.0 0.0 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>

</robot>
